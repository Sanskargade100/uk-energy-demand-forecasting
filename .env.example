# Copy to .env and fill in. .env is git-ignored.

# --- NESO Historic Demand Data (CKAN / datastore) ---
NESO_BASE_URL=https://api.neso.energy
NESO_DEMAND_RESOURCE_ID=

# --- Weather (e.g. Open-Meteo needs no key; Met Office / others do) ---
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# --- Storage ---
DATABASE_URL=sqlite:///data/processed/energy_forecasting.db

# --- App / API ---
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
